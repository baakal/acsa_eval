# ── Database ──────────────────────────────────────────────────────────────────
# Main application database password (used for both acsa_eval and acsa_keycloak)
POSTGRES_PASSWORD=change_me_in_production

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production
# The client secret for the acsa-api Keycloak client (generate a UUID or long random string)
KEYCLOAK_CLIENT_SECRET=change_me_in_production
# Public hostname used by Keycloak for token issuer URLs (no trailing slash)
KEYCLOAK_HOSTNAME=http://localhost:8080

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
MINIO_ACCESS_KEY=change_me_in_production
MINIO_SECRET_KEY=change_me_in_production_at_least_16_chars

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=latest
# Comma-separated list of allowed CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# A long random string used for signing internal tokens / sessions
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@acsa.local
