# ── Database ──────────────────────────────────────────────────────────────────
# Main application database password
POSTGRES_PASSWORD=change_me_in_production

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
MINIO_ACCESS_KEY=change_me_in_production
MINIO_SECRET_KEY=change_me_in_production_at_least_16_chars

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
APP_VERSION=latest
# Comma-separated list of allowed CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# A long random string used for signing internal tokens / sessions
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@acsa.local

# ── Next.js Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft (Azure AD) OAuth ────────────────────────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
